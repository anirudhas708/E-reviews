# Copy these into your hosting environment (or export them) before `npm start`.
PORT=3000
HOST=127.0.0.1                      # use 0.0.0.0 to accept outside connections (e.g. in a container)
NODE_ENV=production

# Admin account (created on first start). Required in production.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-Passw0rd # 8+ characters with a letter and a number
ADMIN_NAME=Site Admin

# Session signing secret. If unset, one is generated and saved in data/.jwt-secret.
JWT_SECRET=

# Behind HTTPS: mark the session cookie Secure. Behind a reverse proxy: trust X-Forwarded-For for rate limiting.
COOKIE_SECURE=true
TRUST_PROXY=false

DATA_DIR=./data
SESSION_TTL_SECONDS=28800
